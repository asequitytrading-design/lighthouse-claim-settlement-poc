# For Databricks Unity Gateway app-model calls only; never commit a real token.
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_TOKEN=
UNITY_GATEWAY_MODEL=system.ai.<approved-model-service>

# Optional: explicit MLflow judge model URI/provider configuration.
# Review the provider's Unity Gateway support before using for governed runs.
MLFLOW_GENAI_JUDGE_DEFAULT_MODEL=
