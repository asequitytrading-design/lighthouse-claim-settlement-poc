# Copy to .env (gitignored) and fill in. Never commit real secrets.
# Scripts load .env automatically without overriding variables already set.

# Which config/profiles/<name>.yaml to use: local | databricks
LIGHTHOUSE_PROFILE=local

# ---- Local: Kong OSS AI gateway (docker compose) ----
# Generate with: openssl rand -hex 24
KONG_API_KEY=
KONG_PG_PASSWORD=
# Optional overrides
# KONG_PROXY_URL=http://localhost:8100/ai
# OLLAMA_UPSTREAM=http://host.docker.internal:11434
# MLFLOW_TRACKING_URI=http://localhost:5000

# ---- Databricks: workspace MLflow + Unity Gateway ----
# On Databricks notebooks/jobs, auth comes from the runtime identity; locally use
# a Databricks CLI profile (DATABRICKS_CONFIG_PROFILE) or host + token.
DATABRICKS_HOST=https://<workspace-host>
# DATABRICKS_TOKEN=
# LIGHTHOUSE_CATALOG=workspace
# LIGHTHOUSE_SCHEMA=lighthouse
UNITY_GATEWAY_SMALL_MODEL=
UNITY_GATEWAY_MEDIUM_MODEL=
UNITY_GATEWAY_JUDGE_MODEL=

# Optional: MLflow judge model URI for --scorer-mode llm-judges.
MLFLOW_GENAI_JUDGE_DEFAULT_MODEL=
